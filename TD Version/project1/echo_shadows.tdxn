format: tdxn
version: '2.1'
build: 8
generator: Embody/6.2.69
td_build: 099.2025.33230
network_path: /project1/echo_shadows
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  boxSOP:
    flags:
    - display
    - render
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  circlePOP:
    parameters:
      connectivity: surface
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  connectivityPOP:
    parameters:
      surftype: lines
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantMAT:
    parameters:
      skelrootpath: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  copyPOP:
    parameters:
      ncy: 2
      rx: 90
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  geometryCOMP:
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  lightCOMP:
    parameters:
      aperture: 41.4214
      coneangle: 72
      conedelta: 22
      coneroll: 1.4
      lighttype: cone
      maxshadowsoftness: 0.03
      projangle: 90
      projmapextendu: hold
      projmapextendv: hold
      shadowcasters: =' '.join(o.path for o in parent.Vis.ops('geo_person*', 'geo_prop_*') if o.par.render.eval())
      shadowtype: soft2d
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  linePOP:
    parameters:
      bypass: =not parent().par.attenuated
      divs: 1
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mergePOP:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mergeSOP:
    flags:
    - display
    - render
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  phongMAT:
    parameters:
      ambb: 0.7
      ambg: 0.7
      ambr: 0.7
      darknessemitcolorr: 0.7
      skelrootpath: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  pointgeneratorPOP:
    parameters:
      numpoints: 17
      shape: circle
      sx: 0.2
      sy: 0.2
      sz: 0.2
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  primitivePOP:
    parameters:
      addpts: true
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  rectanglePOP:
    parameters:
      anchorv: 0
      sizeu: 0.02
      sizev: 0.5
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  spherePOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  sphereSOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  switchPOP:
    parameters:
      index: =parent().par.lighttype.menuIndex
    flags:
    - display
    - render
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    parameters:
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
  textTOP:
    parameters:
      aligny: top
      font: Menlo
      fontsizexunit: pixels
      outputresolution: custom
      resolutionh: 720
      resolutionw: 1280
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  transformPOP:
    parameters:
      tz: 0.8
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  transformTOP:
    parameters:
      fillmode: fill
      outputresolution: custom
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  tubePOP:
    parameters:
      orient: z
      rows: 2
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  tubeSOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
par_templates:
  points:
  - label: Point
    name: pt
    style: Sequence
  - label: Position
    name: Posx
    sequence: pt
    size: 3
    style: XYZW
type: baseCOMP
custom_pars:
  Control:
  - name: Soundmode
    style: Toggle
    label: Sound Mode
    startSection: true
    default: true
    help: Sound-reactive mode (TouchOSC /soundMode). Only runs while Demo Mode is off.
  - name: Demomode
    style: Toggle
    label: Demo Mode
    help: 'Demo mode (TouchOSC /demoMode): light single units by hand with the Unit toggles and RGB faders.'
  - name: Unit1
    style: Toggle
    label: Unit 1 (Red)
    startSection: true
    help: 'Demo mode: all 5 LEDs of unit 1 red at the Red fader level (/unit1).'
  - name: Unit2
    style: Toggle
    label: Unit 2 (Green)
    help: 'Demo mode: all 5 LEDs of unit 2 green at the Green fader level (/unit2).'
  - name: Unit3
    style: Toggle
    label: Unit 3 (Blue)
    help: 'Demo mode: all 5 LEDs of unit 3 blue at the Blue fader level (/unit3).'
  - name: Unit4
    style: Toggle
    label: Unit 4 (Mixed)
    help: 'Demo mode: unit 4 shows the fixed 5-colour test pattern (/unit4).'
  - name: Red
    style: Float
    startSection: true
    clampMin: true
    clampMax: true
    help: Demo level for unit 1 red, 0-1 (TouchOSC /red).
  - name: Green
    style: Float
    clampMin: true
    clampMax: true
    help: Demo level for unit 2 green, 0-1 (TouchOSC /green).
  - name: Blue
    style: Float
    clampMin: true
    clampMax: true
    help: Demo level for unit 3 blue, 0-1 (TouchOSC /blue).
  - name: Booster
    style: Menu
    startSection: true
    default: default
    menuNames:
    - default
    - norbooster
    - boosterplus
    - boosterplus2
    menuLabels:
    - Default
    - NORBOOSTER
    - BOOSTER+
    - BOOSTER++
    help: 'Audio gain preset from the 2024 sketch: Default, NORBOOSTER, BOOSTER+, BOOSTER++. Higher = more reactive to quiet input.'
  - name: Reset
    style: Pulse
    label: Reset Controls
    startSection: true
    help: Set every control back to 0 here and on TouchOSC (same as the TouchOSC reset button).
  Audio:
  - name: Audiosource
    style: Menu
    label: Audio Source
    default: linein
    menuNames:
    - linein
    - file
    menuLabels:
    - Line In
    - Test File
    help: Line In = the audio interface, as in the installation. Test File = play Audiofile so the patterns can be previewed without live music.
    value: file
  - name: Audiofile
    style: File
    label: Test Audio File
    default: /Applications/TouchDesigner.app/Contents/Resources/tfs/Samples/Audio/JeremyCaulfield_www.dumb-unit.com.mp3
    help: Music file used when Audio Source is Test File.
  - name: Inputgain
    style: Float
    label: Input Gain
    default: 1
    clampMin: true
    normMax: 4.0
    help: Multiplies the FFT band values before the booster gains. Recalibrate here if a new audio interface is louder or quieter than the 2024 setup.
  - name: Monitor
    style: Toggle
    label: Monitor Test File
    default: true
    help: Play the test file through the computer speakers.
  Engine:
  - name: Legacydemo
    style: Toggle
    label: Legacy Demo Override
    default: true
    help: 'On = exactly like the 2024 sketch: in sound mode unit1 red, unit2 green, unit3 blue and 7 unit4 channels are always forced to 0 (side effect of the demo blocks). Off = every pattern shows all its colours.'
  - name: Resetengine
    style: Pulse
    label: Reset Engine
    help: 'Restart the engine: pattern timer, fades and DMX targets.'
  - name: Dmxactive
    style: Toggle
    label: DMX Output Active
    startSection: true
    help: Send DMX through the ENTTEC DMX USB Pro. Leave off until the interface is plugged in.
  Visualizer:
  - name: Openpreview
    style: Pulse
    label: Open Preview Window
    help: Open the visualizer output (visualizer/out1) in a floating window.
  - name: Visgain
    style: Float
    label: Beam Brightness
    default: 1.6
    clampMin: true
    normMax: 4.0
    help: 'Visualizer only: brightness of the simulated beams (does not change the DMX output).'
  - name: Personmove
    style: Toggle
    label: Moving Visitor
    default: true
    help: 'Visualizer only: the visitor figure sways slowly in front of the wall so the shadows move.'
  - name: Visitor2
    style: Toggle
    label: Second Visitor
    startSection: true
    default: true
    help: 'Visualizer only: a second visitor with raised arms, standing further back on the left.'
  - name: Proplattice
    style: Toggle
    label: 'Prop: Hanging Lattice'
    default: true
    help: 'Visualizer only: a perforated panel hanging from a string, slowly turning.'
  - name: Propbranch
    style: Toggle
    label: 'Prop: Branch'
    default: true
    help: 'Visualizer only: a branch in a pot on the left side.'
  - name: Smoke
    style: Toggle
    startSection: true
    default: true
    help: 'Visualizer only: the first visitor exhales a puff of smoke every few seconds; it glows in the beams and throws soft coloured shadows.'
  - name: Smokeperiod
    style: Float
    label: Smoke Puff Every (s)
    default: 6
    min: 0.5
    clampMin: true
    normMin: 2.0
    normMax: 15.0
    help: 'Visualizer only: seconds between two exhaled puffs.'
  - name: Smokedensity
    style: Float
    label: Smoke Density
    default: 3
    clampMin: true
    normMax: 4.0
    help: 'Visualizer only: thickness of the smoke, for the visible puff and its shadow.'
parameters:
  parentshortcut: Echo
color: [0.3, 0.5, 0.9]
tags:
- tdxn
comment: 'Echo Shadows: audio -> engine -> DMX (4 units x 20ch) + visualizer'
operators:
- name: engine
  type: scriptCHOP
  parameters:
    callbacks: engine_callbacks
  position: [1400, 200]
  inputs:
  - switch_audio
- name: dmxout1
  type: dmxoutCHOP
  parameters:
    active: =parent.Echo.par.Dmxactive
    interface: enttecusbpro
    rate: =me.time.rate
    routingtable: dmxout1_routingtable
    autoexportroot: =parent()
  position: [3000, 200]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - select_dmx
- name: select_dmx
  type: selectCHOP
  parameters:
    channames: dmx*
    autoexportroot: =parent()
  position: [2600, 200]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - null_engine
- name: visualizer
  type: containerCOMP
  parameters:
    w: 1280
    h: 720
    resizecomp: =me
    repocomp: =me
    top: =me.op('out1')
    topfill: best
    parentshortcut: Vis
    parmreferencewhite: default
  position: [1400, -800]
  size: [160, 130]
  color: [0.67, 0.67, 0.67]
  comment: 3D preview of the 4 fixtures, beams and coloured shadows
  children:
  - name: cam1
    type: cameraCOMP
    parameters:
      tx: 1.4
      ty: 2.5
      tz: 8.6
      rx: -9.59009
      ry: 8.97263
      fov: 52
      aperture: 41.4214
    position: [2200, -600]
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
    children:
    - name: file1
      type: fileinPOP
      parameters:
        file: =app.samplesFolder + '/Geo/defcam.tog'
      flags:
      - display
      - viewer
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
  - name: out1
    type: outTOP
    parameters:
      label: =me.name
    flags:
    - display
    position: [4200, 0]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    inputs:
    - comp_over
  - name: gobo1
    type: transformTOP
    parameters:
      tx: =parent.Vis.op('smoke_proj')['cu'][0] - 0.5
      ty: =parent.Vis.op('smoke_proj')['cv'][0] - 0.5
      sx: =parent.Vis.op('smoke_proj')['su'][0]
      sy: =parent.Vis.op('smoke_proj')['sv'][0]
      bgcolorr: 1
      bgcolorg: 1
      bgcolorb: 1
      bgcolora: 1
      extend: hold
      resolutionw: 512
      resolutionh: 512
    position: [400, -1000]
    inputs:
    - smoke_atten
  - name: gobo2
    type: transformTOP
    parameters:
      tx: =parent.Vis.op('smoke_proj')['cu'][1] - 0.5
      ty: =parent.Vis.op('smoke_proj')['cv'][1] - 0.5
      sx: =parent.Vis.op('smoke_proj')['su'][1]
      sy: =parent.Vis.op('smoke_proj')['sv'][1]
      bgcolorr: 1
      bgcolorg: 1
      bgcolorb: 1
      bgcolora: 1
      extend: hold
      resolutionw: 512
      resolutionh: 512
    position: [400, -1200]
    inputs:
    - smoke_atten
  - name: gobo3
    type: transformTOP
    parameters:
      tx: =parent.Vis.op('smoke_proj')['cu'][2] - 0.5
      ty: =parent.Vis.op('smoke_proj')['cv'][2] - 0.5
      sx: =parent.Vis.op('smoke_proj')['su'][2]
      sy: =parent.Vis.op('smoke_proj')['sv'][2]
      bgcolorr: 1
      bgcolorg: 1
      bgcolorb: 1
      bgcolora: 1
      extend: hold
      resolutionw: 512
      resolutionh: 512
    position: [400, -1400]
    inputs:
    - smoke_atten
  - name: gobo4
    type: transformTOP
    parameters:
      tx: =parent.Vis.op('smoke_proj')['cu'][3] - 0.5
      ty: =parent.Vis.op('smoke_proj')['cv'][3] - 0.5
      sx: =parent.Vis.op('smoke_proj')['su'][3]
      sy: =parent.Vis.op('smoke_proj')['sv'][3]
      bgcolorr: 1
      bgcolorg: 1
      bgcolorb: 1
      bgcolora: 1
      extend: hold
      resolutionw: 512
      resolutionh: 512
    position: [400, -1600]
    inputs:
    - smoke_atten
  - name: light1
    type: lightCOMP
    parameters:
      tx: =parent.Vis.op('fixture_data')['tx'][0]
      ty: =parent.Vis.op('fixture_data')['ty'][0]
      tz: =parent.Vis.op('fixture_data')['tz'][0]
      rx: =parent.Vis.op('fixture_data')['rx'][0]
      ry: =parent.Vis.op('fixture_data')['ry'][0]
      cr: =parent.Vis.op('fixture_data')['r'][0]
      cg: =parent.Vis.op('fixture_data')['g'][0]
      cb: =parent.Vis.op('fixture_data')['b'][0]
      projmap: =parent.Vis.op('gobo1')
    position: [2200, 400]
    children:
    - name: copy1
      type: copyPOP
      position: [520, 670]
      inputs:
      - tube_attenuated
    - name: merge1
      type: mergePOP
      sequences:
        input:
        - {}
        - {}
        - {}
        - {}
        - {}
        - {}
        - {}
      position: [250, 500]
      inputs:
      - rectangle1
      - tube_cone1
      - tube_cone2
      - primitive1
      - line_atten
      - circle_attenStart
      - circle_attenEnd
    - name: merge2
      type: mergePOP
      sequences:
        input:
        - {}
        - {}
      position: [950, 230]
      inputs:
      - connectivity1
      - circle1
    - name: merge3
      type: mergePOP
      sequences:
        input:
        - {}
        - {}
      position: [620, 290]
      inputs:
      - pointgen1
      - transform1
    - name: circle1
      type: circlePOP
      parameters:
        scale: 0.2
      position: [780, 170]
    - name: sphere1
      type: spherePOP
      parameters:
        radx: 0.05
        rady: 0.05
        radz: 0.05
        freq: 3
      flags:
      - viewer
      position: [520, 890]
    - name: pointgen1
      type: pointgeneratorPOP
      position: [270, 290]
    - name: line_atten
      type: linePOP
      sequences:
        pt:
        - posz: =-parent().par.attenuationstart
        - posz: =-parent().par.attenuationend
      custom_pars:
        Points:
          $t: points
      position: [0, 230]
    - name: primitive1
      type: primitivePOP
      parameters:
        method: pattern
      sequences:
        prim:
        - type: lines
          pattern: 0 1 0 2 0 3 0 4
        pt:
        - {}
        - posx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2)) + mod.math.sin(mod.math.radians(parent().par.conedelta/2))
          posz: =-op('tube_cone1').par.height
        - posx: =mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
          posz: =0-op('tube_cone1').par.height
        - posy: =-mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
          posz: =-op('tube_cone1').par.height
        - posy: =mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
          posz: =-op('tube_cone1').par.height
      custom_pars:
        Points:
          $t: points
      flags:
      - viewer
      position: [0, 390]
    - name: rectangle1
      type: rectanglePOP
      position: [0, 730]
    - name: transform1
      type: transformPOP
      position: [450, 370]
      inputs:
      - pointgen1
    - name: tube_cone1
      type: tubePOP
      parameters:
        radx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2))
        rady: 0.01
        height: =mod.math.cos(mod.math.radians(parent().par.coneangle/2))
        tz: =-me.par.height*0.5
      position: [0, 620]
    - name: tube_cone2
      type: tubePOP
      parameters:
        radx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2)) + mod.math.sin(mod.math.radians(parent().par.conedelta/2))
        rady: =mod.math.sin(mod.math.radians(parent().par.coneangle/2))
        height: 0
        tz: =-op('tube_cone1').par.height
      position: [0, 500]
    - name: connectivity1
      type: connectivityPOP
      position: [780, 290]
      inputs:
      - merge3
    - name: circle_attenEnd
      type: circlePOP
      parameters:
        radx: 0.1
        rady: 0.1
        tz: =-parent().par.attenuationend
        bypass: =not parent().par.attenuated
    - name: primitive_cross
      type: primitivePOP
      parameters:
        method: set
        setprimtype: lines
      sequences:
        pt:
        - posx: -0.2
        - posx: 0.2
        - posy: -0.2
        - posy: 0.2
        - posz: -0.2
        - posz: 0.2
      custom_pars:
        Points:
          $t: points
      flags:
      - display
      - render
      - viewer
      position: [520, 1000]
    - name: tube_attenuated
      type: tubePOP
      parameters:
        surftype: rows
        radx: =parent().par.attenuationend
        rady: =parent().par.attenuationstart
        height: 0
        bypass: =not parent().par.attenuated
      position: [368, 673]
    - name: merge_pointLight
      type: mergePOP
      sequences:
        input:
        - {}
        - {}
        - {}
        - {}
      position: [760, 820]
      inputs:
      - sphere1
      - primitive_quadrants
      - copy1
    - name: switch_lightType
      type: switchPOP
      position: [1140, 500]
      inputs:
      - merge_pointLight
      - merge1
      - merge2
    - name: circle_attenStart
      type: circlePOP
      parameters:
        radx: 0.1
        rady: 0.1
        tz: =-parent().par.attenuationstart
        bypass: =not parent().par.attenuated
      position: [0, 120]
    - name: primitive_quadrants
      type: primitivePOP
      parameters:
        method: set
        setprimtype: lines
      sequences:
        pt:
        - posx: 0.07
          posy: 0.07
          posz: 0.07
        - posx: -0.07
          posy: -0.07
          posz: -0.07
        - posx: -0.07
          posy: 0.07
          posz: 0.07
        - posx: 0.07
          posy: -0.07
          posz: -0.07
        - posx: 0.07
          posy: 0.07
          posz: -0.07
        - posx: -0.07
          posy: -0.07
          posz: 0.07
        - posx: -0.07
          posy: 0.07
          posz: -0.07
        - posx: 0.07
          posy: -0.07
          posz: 0.07
      custom_pars:
        Points:
          $t: points
      flags:
      - viewer
      position: [520, 780]
  - name: light2
    type: lightCOMP
    parameters:
      tx: =parent.Vis.op('fixture_data')['tx'][1]
      ty: =parent.Vis.op('fixture_data')['ty'][1]
      tz: =parent.Vis.op('fixture_data')['tz'][1]
      rx: =parent.Vis.op('fixture_data')['rx'][1]
      ry: =parent.Vis.op('fixture_data')['ry'][1]
      cr: =parent.Vis.op('fixture_data')['r'][1]
      cg: =parent.Vis.op('fixture_data')['g'][1]
      cb: =parent.Vis.op('fixture_data')['b'][1]
      projmap: =parent.Vis.op('gobo2')
    position: [2200, 200]
    children:
    - name: copy1
      type: copyPOP
      position: [520, 670]
      inputs:
      - tube_attenuated
    - name: merge1
      type: mergePOP
      sequences:
        input:
        - {}
        - {}
        - {}
        - {}
        - {}
        - {}
        - {}
      position: [250, 500]
      inputs:
      - rectangle1
      - tube_cone1
      - tube_cone2
      - primitive1
      - line_atten
      - circle_attenStart
      - circle_attenEnd
    - name: merge2
      type: mergePOP
      sequences:
        input:
        - {}
        - {}
      position: [950, 230]
      inputs:
      - connectivity1
      - circle1
    - name: merge3
      type: mergePOP
      sequences:
        input:
        - {}
        - {}
      position: [620, 290]
      inputs:
      - pointgen1
      - transform1
    - name: circle1
      type: circlePOP
      parameters:
        scale: 0.2
      position: [780, 170]
    - name: sphere1
      type: spherePOP
      parameters:
        radx: 0.05
        rady: 0.05
        radz: 0.05
        freq: 3
      flags:
      - viewer
      position: [520, 890]
    - name: pointgen1
      type: pointgeneratorPOP
      position: [270, 290]
    - name: line_atten
      type: linePOP
      sequences:
        pt:
        - posz: =-parent().par.attenuationstart
        - posz: =-parent().par.attenuationend
      custom_pars:
        Points:
          $t: points
      position: [0, 230]
    - name: primitive1
      type: primitivePOP
      parameters:
        method: pattern
      sequences:
        prim:
        - type: lines
